---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import portada from '../assets/productos/reg-sai-rojo.png';
import { negocio } from '../data/negocio';

interface Props { titulo: string; descripcion: string }
const { titulo, descripcion } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: portada, width: 875, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: negocio.marca,
  legalName: negocio.razonSocial,
  taxID: negocio.nit,
  description: descripcion,
  telephone: '+' + negocio.whatsappCliente,
  address: { '@type': 'PostalAddress', streetAddress: negocio.direccion, addressLocality: negocio.ciudad, addressRegion: 'Valle del Cauca', addressCountry: 'CO' },
  sameAs: [negocio.instagram],
};
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#f1e7d8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <slot />
  </body>
</html>
