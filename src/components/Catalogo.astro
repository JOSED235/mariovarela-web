---
import { Image, getImage } from 'astro:assets';
import { negocio, productos, TIPOS } from '../data/negocio';

// Datos para la vista rápida y el pedido (cliente). Las imágenes grandes salen optimizadas a WebP.
const datos = await Promise.all(productos.map(async (p) => ({
  id: p.id, nombre: p.nombre, tipo: p.tipo, resumen: p.resumen, detalles: p.detalles, precio: p.precio,
  variantes: await Promise.all(p.variantes.map(async (v) => ({
    id: v.id, nombre: v.nombre, ancho: v.img.width, alto: v.img.height,
    src: (await getImage({ src: v.img, width: Math.min(1000, v.img.width), format: 'webp' })).src,
  }))),
})));
---
<section id="catalogo" class="catalogo seccion" aria-labelledby="catalogo-titulo">
  <div class="catalogo__cabeza">
    <div>
      <span class="rotulo">Catálogo</span>
      <h2 id="catalogo-titulo">Piezas que marcan <em>estilo</em></h2>
    </div>
    <p>Elija modelo y color, arme su pedido y envíelo a nuestro WhatsApp con un toque.</p>
  </div>

  <div class="filtros">
    <div class="chips" role="group" aria-label="Tipo de producto" data-filtros>
      <button type="button" class="chip" aria-pressed="true" data-tipo="">Todo</button>
      {Object.entries(TIPOS).map(([k, v]) => <button type="button" class="chip" aria-pressed="false" data-tipo={k}>{v}</button>)}
    </div>
    <div class="modo" role="group" aria-label="Tipo de compra">
      <button type="button" class="modo__op" aria-pressed="true" data-modo="detal">Al detal</button>
      <button type="button" class="modo__op" aria-pressed="false" data-modo="mayor">Por mayor</button>
    </div>
  </div>
  <p class="aviso-mayor" data-aviso-mayor hidden>Por mayor desde {negocio.minimoMayor} unidades surtidas: mezcle modelos y colores. El precio por mayor se lo enviamos por WhatsApp.</p>

  <ul class="rejilla" data-rejilla>
    {productos.flatMap((p) => p.variantes.map((v, i) => (
      <li class="pieza" data-tipo={p.tipo} data-revelar>
        <button type="button" class="pieza__boton" data-ver={p.id} data-variante={v.id} aria-label={`Ver ${p.nombre}, ${v.nombre}`}>
          <span class="pieza__foto">
            <Image src={v.img} alt={`${p.nombre} ${v.nombre}`} width={560} format="webp" loading={i < 2 ? 'eager' : 'lazy'} />
          </span>
          <span class="pieza__texto">
            <span class="pieza__nombre">{p.nombre}</span>
            <span class="pieza__variante">{v.nombre}</span>
            <span class="pieza__precio">{p.precio ? `$${p.precio.toLocaleString('es-CO')}` : 'Precio por confirmar'}</span>
          </span>
        </button>
      </li>
    )))}
    <li class="pieza pieza--correas" data-tipo="correa" data-revelar>
      <div class="correas">
        <span class="rotulo">Correas</span>
        <p class="correas__cifra" data-contar="350">350</p>
        <p class="correas__texto">diseños de correas en cuero, de XS a XL y a la medida. Desde $50.000 al detal y $23.000 por mayor.</p>
        <a class="boton" href={`https://wa.me/${negocio.whatsapp}?text=${encodeURIComponent('Hola, quiero ver el catálogo de correas.')}`} target="_blank" rel="noopener">Pedir catálogo de correas</a>
      </div>
    </li>
  </ul>
</section>

<dialog class="vista" data-vista aria-labelledby="vista-titulo">
  <div class="vista__cuerpo">
    <button type="button" class="vista__cerrar" data-cerrar-vista aria-label="Cerrar">×</button>
    <figure class="vista__foto"><img data-vista-img alt="" /></figure>
    <div class="vista__info">
      <span class="rotulo" data-vista-tipo></span>
      <h3 id="vista-titulo" data-vista-nombre></h3>
      <p class="vista__precio" data-vista-precio></p>
      <p data-vista-resumen></p>
      <ul class="vista__detalles" data-vista-detalles></ul>
      <fieldset class="aros">
        <legend>Color: <strong data-vista-variante></strong></legend>
        <div class="aros__lista" data-vista-aros></div>
      </fieldset>
      <div class="vista__comprar">
        <label class="campo cantidad">Cantidad
          <input type="number" min="1" value="1" inputmode="numeric" data-vista-cantidad />
        </label>
        <button type="button" class="boton" data-agregar>Agregar al pedido</button>
      </div>
    </div>
  </div>
</dialog>

<script type="application/json" id="catalogo-datos" set:html={JSON.stringify({ productos: datos, minimo: negocio.minimoMayor, whatsapp: negocio.whatsapp })} />

<style>
  .catalogo__cabeza { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: calc(var(--u) * 6); align-items: end; margin-bottom: calc(var(--u) * 6); }
  .catalogo__cabeza p { color: var(--texto-2); font-size: var(--t-1); }
  .filtros { display: flex; flex-wrap: wrap; justify-content: space-between; gap: calc(var(--u) * 2); padding-block: calc(var(--u) * 2); border-block: 1px solid color-mix(in oklch, var(--negro) 18%, transparent); margin-bottom: calc(var(--u) * 5); }
  .chips, .modo { display: flex; gap: var(--u); overflow-x: auto; scrollbar-width: none; }
  .chip, .modo__op { flex: none; min-height: 44px; padding: 0 calc(var(--u) * 2.5); border: 1px solid transparent; border-radius: 999px; background: none; font: 600 0.78rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; }
  .chip[aria-pressed='true'] { border-color: var(--negro); }
  .modo { border: 1px solid var(--negro); border-radius: 999px; padding: 3px; gap: 0; }
  .modo__op { min-height: 38px; }
  .modo__op[aria-pressed='true'] { background: var(--negro); color: var(--travertino); }
  .aviso-mayor { margin: -16px 0 calc(var(--u) * 4); padding: calc(var(--u) * 2) calc(var(--u) * 3); background: var(--negro); color: var(--travertino); }
  .rejilla { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(var(--u) * 6) calc(var(--u) * 3); list-style: none; margin: 0; padding: 0; }
  /* escalones de travertino: la columna central baja */
  @media (min-width: 901px) { .pieza:nth-child(3n + 2) { transform: translateY(calc(var(--u) * 6)); } }
  .pieza[hidden] { display: none; }
  .pieza__boton { display: grid; gap: calc(var(--u) * 2); width: 100%; padding: 0; border: 0; background: none; text-align: left; cursor: pointer; }
  /* las fotos son piezas de campaña con texto arriba: se encuadra hacia el producto */
  .pieza__foto { display: block; aspect-ratio: 1; overflow: hidden; background: var(--piedra); }
  .pieza__foto img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transition: transform 1.1s var(--curva); }
  .pieza[data-tipo='bolso'] .pieza__foto img { object-position: 30% 100%; }
  .pieza__boton:hover .pieza__foto img { transform: scale(1.05); }
  .pieza__texto { display: grid; gap: 2px; }
  .pieza__nombre { font: 450 var(--t-1)/1.15 var(--serif); }
  .pieza__variante { color: var(--texto-2); font-size: 0.92rem; }
  .pieza__precio { font: 600 0.78rem/1.6 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--conac); }
  .correas { display: flex; flex-direction: column; justify-content: center; height: 100%; min-height: 420px; padding: calc(var(--u) * 5); background: var(--negro); color: var(--travertino); }
  .correas .rotulo { color: var(--oro); }
  .correas__cifra { font: 400 clamp(5rem, 3rem + 6vw, 8rem)/0.9 var(--serif); margin: 0; }
  .correas__texto { margin: calc(var(--u) * 2) 0 calc(var(--u) * 4); color: var(--piedra); }
  .correas .boton { background: var(--travertino); color: var(--negro); border-color: var(--travertino); }
  .correas .boton:hover { background: var(--rojo); border-color: var(--rojo); color: var(--arena); }

  .vista { width: min(1040px, 100% - 32px); max-height: calc(100dvh - 32px); padding: 0; border: 0; background: var(--arena); color: var(--negro); }
  .vista::backdrop { background: color-mix(in oklch, var(--negro) 75%, transparent); }
  .vista[open] { animation: entrar 0.5s var(--curva); }
  @keyframes entrar { from { opacity: 0; transform: translateY(24px); } }
  .vista__cuerpo { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; }
  .vista__cerrar { position: absolute; top: 10px; right: 10px; z-index: 2; width: 44px; height: 44px; border: 1px solid var(--negro); border-radius: 50%; background: var(--arena); font-size: 1.4rem; cursor: pointer; }
  .vista__foto { margin: 0; background: var(--piedra); display: grid; place-items: center; }
  .vista__foto img { width: 100%; height: 100%; max-height: 80dvh; object-fit: contain; }
  .vista__info { padding: calc(var(--u) * 5); overflow-y: auto; }
  .vista__info h3 { font-size: var(--t-3); }
  .vista__precio { font: 600 0.82rem/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase; color: var(--conac); }
  .vista__detalles { padding-left: 1.1em; margin: 0 0 calc(var(--u) * 3); color: var(--texto-2); }
  .aros { border: 0; padding: 0; margin: 0 0 calc(var(--u) * 3); }
  .aros legend { font-size: 0.9rem; margin-bottom: var(--u); }
  .aros__lista { display: flex; flex-wrap: wrap; gap: var(--u); }
  .vista__comprar { display: grid; grid-template-columns: 110px 1fr; gap: calc(var(--u) * 1.5); align-items: end; }

  @media (max-width: 900px) {
    .catalogo__cabeza { grid-template-columns: 1fr; gap: 0; }
    .rejilla { grid-template-columns: repeat(2, 1fr); gap: calc(var(--u) * 3) calc(var(--u) * 1.5); }
    .pieza__nombre { font-size: 1.05rem; }
    .pieza__variante { font-size: 0.82rem; }
    .pieza--correas { grid-column: 1 / -1; }
    .correas { min-height: 0; }
    .vista { width: 100%; max-height: 92dvh; margin: auto 0 0; }
    .vista__cuerpo { grid-template-columns: 1fr; }
    .vista__foto img { max-height: 46dvh; }
  }
</style>
